# ==========================================
# TradeLink Environment Configuration Example
# ==========================================

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ==========================================
# Supabase PostgreSQL Configuration
# ==========================================
# In Supabase: Project Settings -> Database -> Connection string -> URI
# - DATABASE_URL uses Port 6543 (PgBouncer connection pooler) for API runtime queries
# - DIRECT_URL uses Port 5432 (Direct connection) for Prisma migrations & db push
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Authentication & Security
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="replace-with-at-least-32-random-characters-secret"
JWT_REFRESH_EXPIRATION="7d"

# Initial Admin Seeding Configuration
ADMIN_DEFAULT_EMAIL="admin@uc.edu.ph"
ADMIN_DEFAULT_PASSWORD="ReplaceWithStrongPassword123!"
ADMIN_DEFAULT_NAME="TradeLink Administrator"

# S3-Compatible Object Storage (Supabase Storage S3 / MinIO / AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-southeast-1"
S3_BUCKET="tradelink-uploads"
S3_ACCESS_KEY="tradelink"
S3_SECRET_KEY="tradelink_dev"
S3_FORCE_PATH_STYLE="true"

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=""

# Email Delivery (SendGrid or AWS SES)
EMAIL_PROVIDER="mock" # "sendgrid" | "ses" | "mock"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@tradelink.app"

# Client-facing public API
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_WS_URL="ws://localhost:4000"
